# 复制为 .env 后填写。至少填两家模型的 key，才能演示"中途切换模型"。
# 推荐：MODEL_A 用便宜/快的模型做采集，MODEL_B 用强模型写报告

# —— 模型 key（按需填写）——
# 内置 provider 直接读这些环境变量
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
# models.json 里自定义的国内 provider 读这两个
DEEPSEEK_API_KEY=
DASHSCOPE_API_KEY=

# —— 演示用的两个模型，格式 provider/modelId ——
# 自定义 provider 名称见 models.json（cn-deepseek / cn-qwen）
# 内置模型的准确 id 以本机 `npx pi --list-models` 输出为准
MODEL_A=cn-deepseek/deepseek-chat
MODEL_B=cn-qwen/qwen-plus

# —— 舆情数据源 ——
# mock：离线演示语料（data/corpus.json，虚构品牌）
# live：调用真实舆情查询服务（需要填下面两项；字段映射在 src/social/live.ts）
# replay：只回放 live 录下的缓存，现场断网也能跑
SOCIAL_MODE=mock
SOCIAL_API_BASE=
SOCIAL_API_TOKEN=
# mock 模式下每次查询的模拟延迟（毫秒），给 kill 留时间窗口
SOCIAL_MOCK_LATENCY_MS=800

# 输入框里的默认任务（不填用内置的栖木咖啡示例）
DEMO_TASK=

# Web UI 端口
PORT=5173

# 每次工具调用前人为停顿多少毫秒。让现场观众看得清每一步，也方便你找时机 kill
DEMO_STEP_DELAY_MS=1200

# 自动压缩演示：上下文超过这个 token 数就自动触发 compaction。留空表示用 Pi 默认阈值
# 现场想看自动压缩，可以设成 12000 左右（舆情帖子原文多，比周报场景更容易触发）
DEMO_COMPACT_AT_TOKENS=
# 压缩时保留最近多少 token 的原文（Pi 默认 20000，演示调小才看得出效果）
DEMO_KEEP_RECENT_TOKENS=4000
